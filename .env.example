# Jungle Digits local server settings. Restart the server after editing.
# The Banana API is public and needs no API key.
BANANA_API_URL=https://marcconrad.com/uob/banana/api.php?out=json
BANANA_API_TIMEOUT_MS=6500
# Authentication runtime settings. Never commit real secrets.
AUTH_ORIGIN=http://localhost:5173
# Generate a 32-byte encryption key (64 hexadecimal characters). Keep it stable.
MFA_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
